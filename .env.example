# Frontend: URL of the deployed FastAPI backend (no trailing slash)
REACT_APP_API_URL=http://localhost:8000

# Backend: comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

# Backend: Pokemon Price Tracker API key (only needed for syncing live prices)
POKEMON_PRICE_TRACKER_API_KEY=

# Backend: location of the SQLite database file
DATABASE_PATH=backend/inventory.db
